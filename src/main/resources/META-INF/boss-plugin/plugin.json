{
  "manifestVersion": 1,
  "pluginId": "ai.rever.boss.plugin.dynamic.replay",
  "displayName": "Session Replay Viewer",
  "version": "0.1.0",
  "apiVersion": "1.0.93",
  "minApiVersion": "1.0.93",
  "minBossVersion": "9.4.2",
  "mainClass": "ai.rever.boss.plugin.dynamic.replay.ReplayDynamicPlugin",
  "type": "mixed",
  "description": "Visual, step-by-step playback of rparecorder session files - timeline + per-step narrative",
  "author": "Risa Labs",
  "url": "https://github.com/choksi2212/boss-plugin-session-replay-viewer",
  "panel": {
    "position": "left_bottom",
    "priority": 66
  },
  "sandbox": {
    "maxThreads": 4,
    "maxRestartAttempts": 3,
    "heartbeatIntervalMs": 5000
  },
  "isolationMode": "out-of-process",
  "fallback": "in-process"
}
